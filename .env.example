# 1. NASA API & EARTHDATA KONFİQURASİYASI
NASA_API_KEY=DEMO_KEY
NASA_EARTHDATA_TOKEN=

# 2. AGROAI – SÜNİ İNTELLEKT AQRONOM MODELİ KONFİQURASİYASI
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# 3. HAVA PROQNOZU VƏ PEYK XƏRİTƏ MƏNBƏLƏRİ
# Open-Meteo (real vaxt və 7 günlük aqrometeoroloji proqnoz üçün rəsmi açıq API)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search/granules.json
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# 4. TƏHLÜKƏSİZLİK VƏ SESSİYA
AUTH_SECRET=agroorbit-enterprise-secret-key-change-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000



